
# PostgreSQL 17 - Host-Based Authentication
# ASIR Database Security Laboratory
#
# Sanitized educational example.
# Replace the example subnet with the authorized network
# before adapting this configuration to another environment.
#
# Rule order is important: PostgreSQL uses the first
# matching rule.

# TYPE   DATABASE      USER       ADDRESS           METHOD

# Local connections require SCRAM authentication
local    all           all                          scram-sha-256

# IPv4 loopback
host     all           all        127.0.0.1/32       scram-sha-256

# IPv6 loopback
host     all           all        ::1/128            scram-sha-256

# Authorized private Docker network (example only)
host     all           all        10.77.0.0/24       scram-sha-256

# Local replication
local    replication   all                          scram-sha-256
host     replication   all        127.0.0.1/32       scram-sha-256
host     replication   all        ::1/128            scram-sha-256

# Explicitly reject all other IPv4 and IPv6 connections
host     all           all        0.0.0.0/0          reject
host     all           all        ::/0               reject

# Explicitly reject other replication connections
host     replication   all        0.0.0.0/0          reject
host     replication   all        ::/0               reject
