
# PostgreSQL Administration & Security Lab
# Prevent accidental publication of sensitive files

# Environment variables and credentials
.env
.env.*
!.env.example
*.secret
*password*
*credentials*
*token*
*.key
*.pem
*.p12
*.pfx

# Database backups and exported data
*.sql.gz
*.dump
*.backup
*.bak
*.tar
*.tar.gz
*.sqlite
*.db
backups/
dumps/
exports/
pgdata/
postgres_data/

# PostgreSQL configuration containing secrets
.pgpass
pgpass.conf
postgresql.auto.conf

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
